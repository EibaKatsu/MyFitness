# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable/anon key ではなく、ローカルサーバー専用の secret/service_role key
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 既存の検証用トークンをそのまま使う場合（移動・コピーは不要）
GARMIN_TOKEN_STORE=~/.garminconnect_personal

# 任意。通常は変更不要
MYFITNESS_LOG_LEVEL=INFO
# Garminへの連続アクセスを抑えるため、1回の同期で詳細取得する活動数
MYFITNESS_DETAIL_SYNC_LIMIT=10
